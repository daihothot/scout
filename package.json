{
  "name": "scout",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "tui": "npm run build && node dist/src/run/run-tui.js",
    "test": "npm run build && node --test \"dist/tests/unit/**/*.test.js\"",
    "test:integration": "npm run build && SCOUT_RUN_CODEX_APP_SERVER_INTEGRATION=1 node --test \"dist/tests/integration/**/*.test.js\"",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.17",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@openai/codex": "0.150.1",
    "ink": "^7.1.0",
    "marked": "^18.0.6",
    "react": "^19.2.7"
  }
}
