{
  "servers": {
    "scout_local_capability": {
      "command": "node",
      "args": [
        "assets/scout/plugins/mock/scout-local-capability-plugin/.codex/mcp/scout-local-capability.cjs"
      ],
      "smoke": {
        "tool": "scout_capability_echo",
        "arguments": {
          "message": "preflight"
        }
      }
    },
    "codegraph": {
      "command": "node",
      "args": [
        "assets/scout/mcp/codegraph/wrapper.cjs"
      ],
      "cwd": "${SCOUT_ROOT}",
      "env": {
        "SCOUT_MCP_TARGET_PATH": "${SCOUT_ROOT}"
      },
      "writableRoots": [
        "${SCOUT_ROOT}/.codegraph"
      ],
      "smoke": {
        "tool": "codegraph_search",
        "arguments": {
          "query": "CodeGraph",
          "limit": 1,
          "projectPath": "${SCOUT_ROOT}"
        }
      }
    }
  }
}
