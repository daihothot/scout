{
  "defaults": {
    "config": "config/base.config.toml",
    "model": {
      "id": "gpt-5.5",
      "provider": "custom",
      "reasoningEffort": "high",
      "reasoningSummary": "concise"
    },
    "maxThreads": 6,
    "maxDepth": 1
  },
  "phases": {
    "workers": {
      "research": {
        "edges": {
          "completed": "research-reviewer",
          "error": null
        }
      },
      "research-reviewer": {
        "edges": {
          "completed": "verify",
          "error": "research"
        }
      },
      "verify": {
        "edges": {
          "completed": "verify-reviewer",
          "error": null
        }
      },
      "verify-reviewer": {
        "edges": {
          "completed": null,
          "error": "verify"
        }
      }
    }
  },
  "resources": {
    "common-inspection": {
      "default": true,
      "phases": [
        "Synthesis"
      ],
      "shellTools": [
        "scoutAssets",
        "scoutMemory",
        "cat",
        "sed",
        "pwd"
      ],
      "mcpServers": [],
      "plugins": [],
      "readableRoots": [],
      "writableRoots": []
    },
    "worker-core": {
      "phases": [
        "research",
        "research-reviewer",
        "verify",
        "verify-reviewer"
      ],
      "shellTools": [
        "scoutAssets",
        "scoutMemory",
        "scoutJsonWrite",
        "jarvis",
        "codegraph",
        "rg",
        "git",
        "cat",
        "sed",
        "find",
        "grep",
        "ls",
        "pwd"
      ],
      "mcpServers": [],
      "plugins": [],
      "readableRoots": [
        "~/.guru/knowledge",
        "~/.codegraph"
      ],
      "writableRoots": [
        "~/.guru/codebase",
        "~/.codegraph"
      ]
    },
    "repository-access": {
      "phases": [
        "research",
        "verify"
      ],
      "shellTools": [],
      "mcpServers": [],
      "plugins": [],
      "readableRoots": [
        "${SCOUT_ROOT}"
      ],
      "writableRoots": []
    },
    "research-artifacts": {
      "phases": [
        "research"
      ],
      "shellTools": [
        "scoutResearchArtifactCheck",
        "scoutArtifactDigest"
      ],
      "mcpServers": [],
      "plugins": [],
      "readableRoots": [],
      "writableRoots": []
    },
    "artifact-review": {
      "phases": [
        "research-reviewer",
        "verify-reviewer"
      ],
      "shellTools": [
        "scoutArtifactDigest",
        "wc",
        "head",
        "tail",
        "sort",
        "uniq"
      ],
      "mcpServers": [],
      "plugins": [],
      "readableRoots": [
        "~/.guru/codebase"
      ],
      "writableRoots": []
    },
    "runtime-verification": {
      "phases": [
        "verify"
      ],
      "shellTools": [
        "unity",
        "wc",
        "head",
        "tail",
        "sort",
        "uniq"
      ],
      "mcpServers": [
        "scout_local_capability"
      ],
      "plugins": [
        "scout-local-capability-plugin"
      ],
      "readableRoots": [],
      "writableRoots": []
    }
  },
  "roles": {
    "coordinator": {
      "multiAgent": false,
      "customAgents": []
    },
    "researcher": {
      "phases": [
        "research"
      ],
      "multiAgent": true,
      "customAgents": [
        "scout-helper"
      ]
    },
    "validator": {
      "phases": [
        "research-reviewer",
        "verify-reviewer"
      ],
      "multiAgent": true,
      "customAgents": [
        "scout-helper"
      ]
    },
    "verifier": {
      "phases": [
        "verify"
      ],
      "multiAgent": true,
      "customAgents": [
        "scout-helper"
      ]
    }
  }
}
